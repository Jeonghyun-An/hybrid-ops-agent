# 루트의 .env로 복사해 값을 채운다(.env는 커밋하지 않는다). 실행: uv run --env-file .env <명령>
# Gemma(기본 모델) — 회사 GPU vLLM의 OpenAI 호환 주소(끝이 /v1). 회사 서버 주소라 이 파일에는 적지 않는다
HOA_GEMMA_BASE_URL=
# Gemini(회사망 밖 대체·평가 비교 기준) — 개인 Google 계정의 AI Studio 키, 결제를 연결하지 않은 무료 등급
GEMINI_API_KEY=
# 비우면 hoa_agent/llm.py의 기본 모델(gemini-3.5-flash-lite)을 쓴다
HOA_GEMINI_MODEL=
# 선택 — MCP 서버가 쓸 읽기 전용 kubeconfig(기본 ~/.kube/hoa-kind-mcp-read.kubeconfig)와 허용 네임스페이스(기본 demo)
# HOA_MCP_KUBECONFIG=
# HOA_MCP_ALLOWED_NAMESPACES=
